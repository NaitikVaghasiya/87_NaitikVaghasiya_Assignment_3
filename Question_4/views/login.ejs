<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexis ERP • Executive Admin Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #070c18;
            --bg-card: #0e172a;
            --bg-input: #091122;
            --border-color: #1a2a4a;
            --border-focus: #3b82f6;
            --primary-blue: #2563eb;
            --primary-hover: #1d4ed8;
            --accent-cyan: #38bdf8;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            --error-bg: rgba(239, 68, 68, 0.12);
            --error-border: rgba(239, 68, 68, 0.4);
            --error-text: #fca5a5;
            --shadow-glow: 0 0 35px rgba(37, 99, 235, 0.25);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background-image: 
                radial-gradient(circle at 10% 15%, rgba(37, 99, 235, 0.18) 0%, transparent 45%),
                radial-gradient(circle at 90% 85%, rgba(56, 189, 248, 0.1) 0%, transparent 45%);
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7), var(--shadow-glow);
            padding: 40px;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #1d4ed8, #2563eb, #38bdf8);
        }

        .badge-admin {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            background: rgba(37, 99, 235, 0.15);
            color: var(--accent-cyan);
            border: 1px solid rgba(56, 189, 248, 0.3);
            margin-bottom: 14px;
        }

        .login-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }

        .login-subtitle {
            color: var(--text-muted);
            font-size: 0.92rem;
            line-height: 1.5;
            margin-bottom: 26px;
        }

        .alert-error {
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 22px;
            color: var(--error-text);
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .input-control {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 12px 14px;
            color: var(--text-light);
            font-size: 0.95rem;
            transition: all 0.2s ease;
            outline: none;
        }

        .input-control:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
            background: #0d1730;
        }

        .btn-login {
            width: 100%;
            margin-top: 10px;
            background: linear-gradient(135deg, #1d4ed8, #2563eb);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 13px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.6);
            transform: translateY(-1px);
        }

        .credentials-pill {
            margin-top: 26px;
            padding: 12px;
            border-radius: 8px;
            background: rgba(26, 42, 74, 0.35);
            border: 1px dashed var(--border-color);
            font-size: 0.82rem;
            color: var(--text-muted);
            text-align: center;
        }

        .credentials-pill code {
            color: var(--accent-cyan);
            font-weight: 600;
            background: rgba(37, 99, 235, 0.15);
            padding: 2px 6px;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="badge-admin">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #38bdf8;"></span>
            Question 04 • Enterprise ERP Suite
        </div>
        <h1 class="login-title">ERP Administration</h1>
        <p class="login-subtitle">Sign in to manage employee records, automated payroll computation, and account credentials.</p>

        <% if (error) { %>
            <div class="alert-error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Admin Username</label>
                <input 
                    type="text" 
                    name="username" 
                    class="input-control" 
                    placeholder="Enter admin username" 
                    required 
                    autocomplete="username"
                >
            </div>

            <div class="form-group">
                <label>Master Password</label>
                <input 
                    type="password" 
                    name="password" 
                    class="input-control" 
                    placeholder="Enter admin password" 
                    required 
                    autocomplete="current-password"
                >
            </div>

            <button type="submit" class="btn-login">
                Access ERP Console &rarr;
            </button>
        </form>

        <div class="credentials-pill">
            Admin Auth: User: <code>admin</code> | Pass: <code>admin123</code>
        </div>
    </div>

</body>
</html>