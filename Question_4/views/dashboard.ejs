<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard - ERP</title>
    <style>
        body {
            background-color: #0b1120;
            color: #f8fafc;
            font-family: Arial, sans-serif;
            padding: 30px;
        }
        h2 {
            color: #38bdf8;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 8px;
        }
        a {
            color: #60a5fa;
            text-decoration: none;
            margin-right: 15px;
        }
        a:hover {
            text-decoration: underline;
        }
        .btn-add {
            background-color: #2563eb;
            color: #fff;
            padding: 8px 16px;
            border-radius: 4px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 15px;
        }
        .btn-add:hover {
            background-color: #1d4ed8;
            text-decoration: none;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 15px;
        }
        th, td {
            border: 1px solid #1e3a8a;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #1e293b;
            color: #38bdf8;
        }
        .net {
            color: #38bdf8;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h2>ERP Admin Dashboard</h2>

    <a href="/employee/add" class="btn-add">+ Add Employee</a>
    <a href="/logout" style="color: #f87171; float: right;">Logout</a>

    <table>
        <thead>
            <tr>
                <th>Emp ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Basic (₹)</th>
                <th>HRA (20%)</th>
                <th>DA (10%)</th>
                <th>PF (12%)</th>
                <th>Net Salary (₹)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% employees.forEach(employee => { %>
                <tr>
                    <td><%= employee.empid %></td>
                    <td><strong><%= employee.name %></strong></td>
                    <td><%= employee.email %></td>
                    <td><%= employee.department %></td>
                    <td>₹<%= employee.basicSalary %></td>
                    <td>₹<%= employee.hra %></td>
                    <td>₹<%= employee.da %></td>
                    <td>₹<%= employee.pf %></td>
                    <td class="net">₹<%= employee.netSalary %></td>
                    <td>
                        <a href="/employee/edit/<%= employee._id %>">Edit</a> |
                        <a href="/employee/delete/<%= employee._id %>" style="color: #f87171;" onclick="return confirm('Delete this record?')">Delete</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</body>
</html>