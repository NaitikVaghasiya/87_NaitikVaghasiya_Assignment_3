<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Registration Details</title>
    <style>
        body {
            background-color: #0b1120;
            color: #f8fafc;
            font-family: Arial, sans-serif;
            padding: 30px;
        }
        h2 {
            color: #38bdf8;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 8px;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            max-width: 650px;
            margin-top: 15px;
        }
        th, td {
            border: 1px solid #1e3a8a;
            padding: 10px 14px;
            text-align: left;
        }
        th {
            background-color: #1e293b;
            color: #38bdf8;
        }
        a {
            color: #60a5fa;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        img {
            border-radius: 4px;
            margin-bottom: 5px;
        }
    </style>
</head>
<body>

    <h2>Registration Details</h2>

    <table>
        <tr>
            <th>Field</th>
            <th>Value</th>
        </tr>
        <tr>
            <td>Username</td>
            <td><%= user.username %></td>
        </tr>
        <tr>
            <td>Email</td>
            <td><%= user.email %></td>
        </tr>
        <tr>
            <td>Gender</td>
            <td><%= user.gender %></td>
        </tr>
        <tr>
            <td>Hobbies</td>
            <td><%= Array.isArray(user.hobbies) ? user.hobbies.join(", ") : user.hobbies %></td>
        </tr>
        <tr>
            <td>Profile Picture</td>
            <td>
                <% if (profilePic) { %>
                    <img src="/uploads/<%= profilePic %>" width="140"><br>
                    <a href="/download/<%= profilePic %>">Download Profile Picture</a>
                <% } else { %>
                    No image uploaded
                <% } %>
            </td>
        </tr>
        <tr>
            <td>Other Pictures</td>
            <td>
                <% if (otherPics && otherPics.length > 0) { %>
                    <% otherPics.forEach(pic => { %>
                        <div style="margin-bottom: 10px;">
                            <img src="/uploads/<%= pic %>" width="140"><br>
                            <a href="/download/<%= pic %>">Download File</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    No other pictures uploaded
                <% } %>
            </td>
        </tr>
    </table>

    <br><br>
    <a href="/">&larr; Back to Registration</a>

</body>
</html>